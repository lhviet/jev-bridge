# Your TypeSafe API key. Get one at https://console.typesafe.ai/keys
#
# Recommended: copy this file to ~/.jev-bridge/.env and lock it down:
#   mkdir -p ~/.jev-bridge && chmod 700 ~/.jev-bridge
#   cp .env.example ~/.jev-bridge/.env && chmod 600 ~/.jev-bridge/.env
#
# A .env at the repository root also works, and is gitignored.
TYPESAFE_API_KEY=
